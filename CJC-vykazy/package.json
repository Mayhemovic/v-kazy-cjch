{
  "name": "cjc-vykazy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && node --env-file=.env scripts/dev.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "prepare:hosting": "npm run check && npm test && npm run build",
    "init:local": "node scripts/create-env.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
